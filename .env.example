# Business contact values used across the site (contact dialog, footer, logo).
# All are inlined into the client bundle at build time; the site works fine
# with the defaults in lib/config/site.ts, so a .env is optional.
# Copy this file to .env.local to override any of these.

NEXT_PUBLIC_SITE_NAME=Ventura Auto
NEXT_PUBLIC_ASSISTANT_NAME=Ventura Auto
NEXT_PUBLIC_SITE_EMAIL=halo@venturaauto.id
NEXT_PUBLIC_SITE_PHONE=+62 812 1000 2000

# Server-side (never exposed to the client). The chatbot route handler returns a
# graceful "offline" reply when GROQ_API_KEY is not set, so the site still works.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_GUARD_MODEL=llama-3.1-8b-instant